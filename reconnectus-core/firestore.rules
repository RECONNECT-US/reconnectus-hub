rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().status == "active"; }
    function isManager() { return active() && (profile().role == "manager" || profile().role == "superadmin"); }
    function isSuperAdmin() { return active() && profile().role == "superadmin"; }

    match /system/config {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(/databases/$(database)/documents/system/config) && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isManager());
      allow create: if signedIn() && (
        (request.auth.uid == userId && request.resource.data.role == "superadmin" && get(/databases/$(database)/documents/system/config).data.ownerUid == request.auth.uid)
        || isManager()
      );
      allow update: if signedIn() && (
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.allowedApps == resource.data.allowedApps)
        || (isManager() && (isSuperAdmin() || (resource.data.role != "superadmin" && request.resource.data.role != "superadmin")))
      );
      allow delete: if isSuperAdmin() && request.auth.uid != userId;
    }

    match /apps/{appId} {
      allow read: if active();
      allow create, update: if isManager();
      allow delete: if isSuperAdmin();
    }

    match /users/{userId}/trainingRecords/{recordId} {
      allow read, write: if active() && (request.auth.uid == userId || isManager());
    }
  }
}
